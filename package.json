{
  "name": "next-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "kill -9 $(lsof -ti:3000) 2>/dev/null || true && rm -rf .next && next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "svgr public/images/svg -d src/components/icons --icon --replace-attr-values \"#fff=currentColor,#000=currentColor,white=currentColor,black=currentColor\"",
    "schema": "node nextwp/scripts/build-schema.js",
    "defaults": "node scripts/check-defaults.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "next": "16.1.6",
    "normalize.css": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sass": "^1.97.3"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "open": "^11.0.0",
    "@babel/parser": "^7.26.0"
  }
}